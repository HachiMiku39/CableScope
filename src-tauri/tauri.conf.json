{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CableScope",
  "mainBinaryName": "CableScope",
  "identifier": "com.cablescope.app",
  "version": "0.4.0",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "placeholder"
  },
  "app": {
    "windows": [
      {
        "label": "bootstrap",
        "title": "CableScope · 线缆实验室",
        "width": 1360,
        "height": 920,
        "minWidth": 850,
        "minHeight": 640,
        "backgroundColor": "#f5f6fa",
        "visible": false,
        "url": "about:blank"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'",
      "capabilities": ["desktop-minimal"],
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../build/runtime/CableScope/": "collector/",
      "../licenses/": "licenses/"
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "hardenedRuntime": false
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
